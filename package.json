{
  "name": "@cubocompany/opengem",
  "version": "0.5.0",
  "description": "OpenGem — OpenCode plugin for Obsidian. Read, write, search, and build a compounding wiki knowledge base via the Obsidian CLI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./mcp": "./dist/mcp.js"
  },
  "bin": {
    "opengem": "./dist/cli.js",
    "opengem-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "opencode",
    "obsidian",
    "obsidian-plugin",
    "knowledge-base",
    "wiki",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cubocompany/opengem"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target node --external @opencode-ai/plugin --external unpdf && bun build src/tui.ts --outdir dist --format esm --target node --external @opencode-ai/plugin && bun build src/cli.ts --outdir dist --format esm --target node && bun build src/mcp.ts --outdir dist --format esm --target node --external unpdf",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "check": "tsc --noEmit",
    "sync:skills": "bun run scripts/sync-upstream-skills.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/plugin": "1.4.6",
    "@repomix/tree-sitter-wasms": "^0.1.16",
    "chokidar": "^5.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "unpdf": "^1.6.0",
    "web-tree-sitter": "0.26.8"
  },
  "devDependencies": {
    "@opentui/core": "^0.1.99",
    "@opentui/solid": "^0.1.99",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "bun-types": "1.3.12",
    "semantic-release": "^25.0.3",
    "typescript": "5.9.3"
  }
}
